# Salin file ini menjadi: .env
# Lalu isi nilainya. Jangan commit file .env ke Git.

# Wajib: API key penyedia LLM
LLM_API_KEY=

# Opsional: endpoint yang kompatibel dengan OpenAI (default: OpenAI)
# Contoh:
#   OpenAI      : https://api.openai.com/v1
#   DeepSeek    : https://api.deepseek.com/v1
#   OpenRouter  : https://openrouter.ai/api/v1
#   Groq        : https://api.groq.com/openai/v1
#   Ollama lokal: http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Opsional: nama model
# Contoh: gpt-4o-mini, deepseek-chat, llama-3.3-70b-versatile, qwen2.5:7b
LLM_MODEL=gpt-4o-mini

# Opsional: port server web (default 4173)
# PORT=4173
